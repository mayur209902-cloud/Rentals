<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/lightBlue">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true"
        android:background="@color/lightBlue">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Complaints"
                android:textColor="@color/black"
                android:textSize="26sp"
                android:textStyle="bold"
                android:layout_marginBottom="18dp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="15dp"
                android:background="@drawable/bg_rent_summary">

                <!-- First Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="@color/li">

                    <TextView
                        android:id="@+id/btnNewComplaint"
                        style="@style/ComplaintButton"
                        android:layout_marginEnd="5dp"
                        android:text="New Complaint" />

                    <TextView
                        android:id="@+id/btnMyComplaints"
                        style="@style/ComplaintButton"
                        android:layout_marginStart="5dp"
                        android:text="My Complaints" />

                </LinearLayout>

                <!-- Second Row -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/btnPendingComplaints"
                        style="@style/ComplaintButton"
                        android:layout_marginEnd="5dp"
                        android:text="Pending" />

                    <TextView
                        android:id="@+id/btnResolvedComplaints"
                        style="@style/ComplaintButton"
                        android:layout_marginStart="5dp"
                        android:text="Resolved" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>
    </ScrollView>

    <!-- Fixed Bottom Navigation -->
    <include layout="@layout/bottom_navigation" />

</LinearLayout>
