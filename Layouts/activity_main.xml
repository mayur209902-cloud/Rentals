<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F4F7FC"
    android:fillViewport="true">

    <LinearLayout
        android:id="@+id/main"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_horizontal">

        <!-- App Name -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="25dp"
            android:text="Rentals"
            android:textColor="#1555B8"
            android:textSize="32sp"
            android:textStyle="bold" />

        <!-- Login Heading -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="Users Login"
            android:textColor="#172B4D"
            android:textSize="25sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="25dp"
            android:text="Sign in to manage your rental properties"
            android:textColor="#68758B"
            android:textSize="14sp" />

        <!-- Email / Mobile -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Email / Mobile Number"
            android:textStyle="bold"
            android:textColor="#24344D" />

        <EditText
            android:id="@+id/etEmailMobile"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="15dp"
            android:backgroundTint="#1555B8"
            android:hint="Enter email or mobile number"
            android:textColor="@color/black"
            android:inputType="text"
            android:padding="12dp"
            android:singleLine="true" />

        <!-- Owner ID -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Owner ID"
            android:textStyle="bold"
            android:textColor="#24344D" />

        <EditText
            android:id="@+id/etOwnerId"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="15dp"
            android:backgroundTint="#1555B8"
            android:hint="Enter your Owner ID"
            android:textColor="@color/black"
            android:inputType="text"
            android:padding="12dp"
            android:singleLine="true" />

        <!-- Password -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Password"
            android:textStyle="bold"
            android:textColor="#24344D" />

        <EditText
            android:id="@+id/etPassword"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="6dp"
            android:backgroundTint="#1555B8"
            android:hint="Enter your password"
            android:textColor="@color/black"
            android:inputType="textPassword"
            android:padding="12dp"
            android:singleLine="true" />

        <!-- Show Password -->
        <CheckBox
            android:id="@+id/cbShowPassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Show Password"
            android:buttonTint="#1555B8"
            android:textColor="#34445E" />

        <!-- Forgot Password -->
        <TextView
            android:id="@+id/tvForgotPassword"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:padding="8dp"
            android:text="Forgot Password?"
            android:textColor="#1555B8"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true" />

        <!-- Login Button -->
        <Button
            android:id="@+id/btnLogin"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="8dp"
            android:backgroundTint="#075BE5"
            android:text="Login"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- OR -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center"
            android:text="OR"
            android:textColor="#68758B" />

        <!-- OTP Button -->
        <Button
            android:id="@+id/btnVerifyOTP"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginTop="10dp"
            android:backgroundTint="#07976A"
            android:text="Verify with OTP"
            android:textAllCaps="false"
            android:textColor="#FFFFFF" />

        <!-- Google Sign In Option -->
        <Button
            android:id="@+id/btnGoogleSignIn"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:layout_marginTop="14dp"
            android:backgroundTint="#FFFFFF"
            android:elevation="2dp"
            android:text="G   Continue with Google"
            android:textAllCaps="false"
            android:textColor="#202124"
            android:textSize="16sp" />

        <!-- Create Account -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:layout_marginBottom="25dp"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="New owner? "
                android:textColor="#68758B" />

            <TextView
                android:id="@+id/tvCreateAccount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Create Account / Register"
                android:textColor="#1555B8"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true" />

        </LinearLayout>

    </LinearLayout>
</ScrollView>
