<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#B5D4D2">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="My Rental Profile"
                android:textColor="#172B2A"
                android:textSize="26sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Your saved tenant and rental information"
                android:textColor="#425A58"
                android:textSize="14sp"
                android:layout_marginBottom="18dp" />

            <TextView
                android:id="@+id/tvTenantProfile"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#FFFFFF"
                android:padding="20dp"
                android:text="Loading profile details..."
                android:textColor="#222222"
                android:textSize="16sp"
                android:lineSpacingExtra="5dp"
                android:fontFamily="sans"
                android:elevation="3dp" />

            <Button
                android:id="@+id/btnEditTenantProfile"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="18dp"
                android:layout_marginBottom="20dp"
                android:text="EDIT TENANT DETAILS"
                android:textAllCaps="false"
                android:textSize="16sp"
                android:backgroundTint="#2878FF"
                android:textColor="#FFFFFF" />

        </LinearLayout>
    </ScrollView>

    <include layout="@layout/bottom_navigation" />

</LinearLayout>
